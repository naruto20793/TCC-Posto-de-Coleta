# .env.example - copie para .env e edite

# MongoDB local (substitua se necessário)
MONGODB_URI=mongodb://localhost:27017/posto-coleta

# Ou MongoDB Atlas (substitua <usuario> e <senha> pelo seu usuário)
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.mongodb.net/posto-coleta?retryWrites=true&w=majority

# Porta do servidor
PORT=5000

# Ambiente
NODE_ENV=development

# URL do frontend (opcional)
FRONTEND_URL=http://localhost:3000
