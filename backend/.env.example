# Copie para backend/.env. MongoDB Atlas ou replica set local.
MONGODB_URI=mongodb://localhost:27017/posto-coleta?replicaSet=rs0
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Somente para npm run seed; remova a senha após criar a primeira conta.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# Uso temporário para desenvolvimento, nunca produção. Não usado por seed/migração.
USE_MEMORY_DB=false
# Somente fora de produção. Deixe false quando não estiver testando.
# Sem definir, o cadastro público está ativo em desenvolvimento.
ALLOW_PUBLIC_TEST_REGISTRATION=true
